# Multi-stage build for local Docker builds
# Usage: docker build -f dist/Dockerfile.build -t telego .
# With version: docker build -f dist/Dockerfile.build --build-arg VERSION=v0.6.1 -t telego .

FROM alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS certificates

FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder

ARG BUILD_TAGS="poll_opt,gc_opt"
ARG VERSION="dev"
ARG COMMIT="unknown"
ARG DATE="unknown"

WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/gnet/go.mod third_party/gnet/go.sum ./third_party/gnet/
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -tags="${BUILD_TAGS}" \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o telego ./cmd/telego

FROM scratch

COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /src/telego /telego

ENTRYPOINT ["/telego"]
CMD ["run", "-c", "/config.toml"]
